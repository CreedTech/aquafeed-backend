# Environment Variables
NODE_ENV=
PORT=

# MongoDB
MONGODB_URI=
MONGODB_CONNECT_TIMEOUT_MS=15000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=20000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_HEARTBEAT_MS=10000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_RETRY_ATTEMPTS=5
MONGODB_RETRY_DELAY_MS=2000
MONGODB_IPV4_ONLY=true

# Redis
REDIS_URL=

# Session Secret
SESSION_SECRET=
OTP_PEPPER=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
OTP_REQUEST_WINDOW_MS=
OTP_REQUEST_MAX=
OTP_VERIFY_WINDOW_MS=
OTP_VERIFY_MAX=

# Email Service (Gmail SMTP)
# Steps to get Gmail App Password:
# 1. Enable 2FA on your Gmail: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the generated 16-character password below
SMTP_USER=
SMTP_PASS=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# OpenRouter (AI Formulation Analyst)
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_DEFAULT_FREE_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_PAID_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=
OPENROUTER_FREE_MODEL_ALLOWLIST=meta-llama/llama-3.1-8b-instruct:free,qwen/qwen3-14b:free,google/gemma-3-12b-it:free

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App Config
FRONTEND_URL=
ADMIN_URL=
MOBILE_APP_URL=
BACKEND_URL=

# Feature Flags
ENABLE_OTP_AUTH=
ENABLE_PAYMENTS=
ENABLE_NOTIFICATIONS=
